---
import { getRelativeLocaleUrl } from "astro:i18n";
import { defaultLocale } from "@/i18n/locales";

// "/" has no content of its own: send visitors to the default language.
// Vercel redirects "/" at the edge (vercel.json). Astro's built-in page always waits 2 seconds and can't be
// configured, so this page redirects immediately instead.
const target = getRelativeLocaleUrl(defaultLocale, "");
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <title>Netlab Journal</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site ?? Astro.url)} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="color-scheme" content="light dark" />
    <!-- Same colours as --background in theme.css, so there's no white flash in dark mode. -->
    <style is:inline>
      html {
        background: #fdfdfd;
      }
      @media (prefers-color-scheme: dark) {
        html {
          background: #212737;
        }
      }
    </style>
    <script is:inline>
      // Respect the theme the visitor picked on the site (see Layout.astro).
      try {
        const stored = localStorage.getItem("theme");
        if (stored)
          document.documentElement.style.background =
            stored === "dark" ? "#212737" : "#fdfdfd";
      } catch {}
    </script>
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
  </head>
  <body>
    <a href={target}>Netlab Journal</a>
  </body>
</html>
