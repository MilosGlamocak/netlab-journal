---
import { getRelativeLocaleUrl } from "astro:i18n";
import { locales, localeLabels } from "@/i18n/locales";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Same page, other language: "/en/posts/foo/" → "posts/foo/"
const pagePath = stripLocale(stripBase(Astro.url.pathname), locale).replace(
  /^\//,
  ""
);
---

<div
  class="flex items-center justify-center gap-1 font-medium"
  role="group"
  aria-label={t.language.label}
>
  {
    locales.map((l, i) => (
      <>
        {i > 0 && (
          <span aria-hidden="true" class="text-muted-foreground">
            /
          </span>
        )}
        <a
          href={getRelativeLocaleUrl(l, pagePath)}
          hreflang={l}
          lang={l}
          aria-current={l === locale ? "true" : undefined}
          class:list={[
            "px-1 hover:text-accent",
            { "text-accent underline underline-offset-4": l === locale },
          ]}
        >
          {localeLabels[l]}
        </a>
      </>
    ))
  }
</div>
